<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/editVisitTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:layout_marginBottom="16dp"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- labelFor : TalkBack annonce le libellé quand on arrive sur la liste déroulante -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/trailSpinner"
            android:text="@string/visit_trail" />

        <Spinner
            android:id="@+id/trailSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/trailEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/visit_no_trails"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/typeSpinner"
            android:text="@string/visit_type" />

        <Spinner
            android:id="@+id/typeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/conditionSeek"
            android:text="@string/visit_condition" />

        <SeekBar
            android:id="@+id/conditionSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/visit_condition"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/conditionValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAlignment="center" />

        <!-- Prévisualisation en direct de la vue personnalisée -->
        <fr.estiam.traillog.ui.visits.ConditionIndicatorView
            android:id="@+id/conditionPreview"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:conditionScore="50" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/notes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/visitNotesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/saveVisitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
