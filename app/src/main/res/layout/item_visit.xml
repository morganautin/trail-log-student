<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne de la liste des visites : sentier, date/heure, type, nombre de problèmes ouverts -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/visitCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#DDE7DE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Pastille décorative : l'information est déjà dans la description de la carte -->
        <ImageView
            android:id="@+id/visitConditionDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bg_condition_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/visitTrailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/visitDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/visitType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/trail_green"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/visitOpenIssues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="120dp"
            android:paddingStart="8dp"
            android:textAlignment="viewEnd"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
